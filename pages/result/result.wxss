/* pages/result/result.wxss —— 成卦结果页（断占总论三段式） */

.card {
  margin-bottom: 22rpx;
}

.card-h {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-h-t {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.tag {
  margin-left: auto;
  font-size: 20rpx;
  color: #e0402f;
  border: 2rpx solid #e0402f;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}

/* ① 断占总结：一张卡，三行 */
.verdict {
  background: #fdeeeb;
  border: 2rpx solid #f6d9d3;
  border-left: 6rpx solid #e0402f;
  border-radius: 0 28rpx 28rpx 0;
  padding: 24rpx 26rpx;
}

.verdict-k {
  display: block;
  font-size: 21rpx;
  color: #e0402f;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.vline {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
  border-bottom: 2rpx dashed #f0d6d1;
}

.vline.last {
  border-bottom: none;
  padding-bottom: 2rpx;
}

.vk {
  width: 56rpx;
  flex: none;
  font-size: 21rpx;
  color: #e0402f;
  letter-spacing: 1rpx;
  padding-top: 4rpx;
}

.vt {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.8;
}

.vline.last .vt {
  color: #e0402f;
  font-weight: 600;
}

/* ② 本卦：卦象与标记 */
.hex-head {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 10rpx;
}

.seal {
  width: 72rpx;
  height: 72rpx;
  line-height: 1.15;
  border-radius: 14rpx;
  background: #e0402f;
  color: #ffffff;
  font-size: 24rpx;
  text-align: center;
  padding: 8rpx 6rpx;
  box-sizing: border-box;
  margin-right: 18rpx;
  box-shadow: 0 6rpx 14rpx rgba(224, 64, 47, 0.32);
}

.hex-name {
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
}

.trigrams {
  margin-top: 10rpx;
  text-align: center;
  font-size: 22rpx;
  color: #71767f;
  letter-spacing: 2rpx;
}

.hr {
  height: 2rpx;
  background: #eceef1;
  margin: 20rpx 0;
}

.hex {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  width: 100%;
  margin-top: 16rpx;
}

/* 六爻严格对齐：行宽固定为 100%，卦象按行中线绝对居中。
   爻题、营数、标记分列左右两端且脱离文档流，不参与居中计算；
   否则标记个数不同会让行宽随内容变化，居中后各爻横画左右漂移。 */
.hex-line {
  position: relative;
  width: 100%;
  height: 44rpx;
  min-height: 44rpx;
  margin-bottom: 8rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.hex-line.yi {
  background: #f7f8fa;
  box-shadow: inset 4rpx 0 0 #15171c;
}

.hex-label {
  position: absolute;
  left: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 44rpx;
  text-align: right;
  font-size: 24rpx;
  color: #71767f;
  font-family: "Songti SC", "STSong", serif;
}

.hex-bars {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 240rpx;
  height: 18rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.bar {
  width: 240rpx;
  height: 18rpx;
  background: #15171c;
  border-radius: 4rpx;
  flex: none;
}

.bar.half {
  width: 108rpx;
}

.bar.changing {
  background: #e0402f;
}

.yin {
  width: 240rpx;
  display: flex;
  justify-content: space-between;
  flex: none;
}

.hex-val {
  position: absolute;
  left: 66rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 90rpx;
  font-size: 21rpx;
  color: #15171c;
}

.marks {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
}

.mk {
  font-size: 18rpx;
  line-height: 28rpx;
  padding: 0 6rpx;
  border-radius: 6rpx;
  margin-left: 4rpx;
  white-space: nowrap;
  flex: none;
}

.mk.change {
  color: #e0402f;
  background: #fdeeeb;
}

.mk.yi {
  color: #15171c;
  border: 2rpx dashed #15171c;
  background: #ffffff;
}

.mk.main {
  background: #e0402f;
  color: #ffffff;
  font-weight: 600;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  font-size: 18rpx;
  color: #a2a6ad;
  margin: 10rpx 0 4rpx;
}

.legend text {
  margin-right: 18rpx;
}

/* 卦辞与六爻爻辞清单（本卦、变卦共用） */
.lbl {
  display: block;
  font-size: 21rpx;
  color: #e0402f;
  letter-spacing: 4rpx;
  margin: 20rpx 0 8rpx;
}

.juan-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.9;
  letter-spacing: 1rpx;
}

.ylist {
  margin-top: 6rpx;
}

.yline {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 12rpx;
  border-bottom: 2rpx solid #eceef1;
  border-radius: 8rpx;
}

.yline.main {
  background: #fdeeeb;
}

.yp {
  width: 62rpx;
  flex: none;
  font-size: 23rpx;
  color: #71767f;
  font-family: "Songti SC", "STSong", serif;
}

.yline.main .yp,
.yline.chg .yp {
  color: #e0402f;
}

.yc {
  flex: 1;
  font-size: 23rpx;
  line-height: 1.75;
  color: #3a3d44;
}

.yline.main .yc {
  color: #15171c;
}

.prefix {
  color: #e0402f;
  font-weight: 600;
  margin-right: 6rpx;
}

.prefix.ref {
  color: #a2a6ad;
  font-weight: 400;
}

/* ③ 变卦：一至两张之卦卡 */
.empty {
  text-align: center;
  padding: 40rpx 20rpx;
  color: #a2a6ad;
  font-size: 22rpx;
  line-height: 1.9;
  background: #fafbfc;
  border: 2rpx dashed #d8dce0;
  border-radius: 20rpx;
}

.empty text {
  display: block;
}

.subcard {
  background: #fafbfc;
  border: 2rpx solid #eceef1;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.subcard.primary {
  border-color: #e0402f;
  background: #ffffff;
}

.subcard.mute {
  opacity: 0.72;
}

.subcard-h {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.sub-t {
  font-size: 25rpx;
  font-weight: 600;
}

.badge {
  margin-left: auto;
  font-size: 19rpx;
  color: #71767f;
  border: 2rpx solid #d8dce0;
  border-radius: 6rpx;
  padding: 0 10rpx;
  white-space: nowrap;
}

.subbody {
  display: flex;
  align-items: flex-start;
}

.minihex {
  width: 120rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  margin-right: 20rpx;
  padding-top: 4rpx;
}

/* 每条爻行固定宽度，阴阳爻画都按同一中线居中 */
.mline {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 16rpx;
  margin-bottom: 4rpx;
  box-sizing: border-box;
}

.mbar {
  height: 10rpx;
  background: #15171c;
  border-radius: 2rpx;
}

.mbar.full {
  width: 110rpx;
}

.mbar.half {
  width: 46rpx;
}

.mbar.c {
  background: #e0402f;
}

.mbar-h {
  width: 110rpx;
  display: flex;
  justify-content: space-between;
}

.subtxt {
  flex: 1;
  min-width: 0;
}

.sub-nm {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.slbl {
  display: block;
  font-size: 19rpx;
  color: #e0402f;
  letter-spacing: 3rpx;
  margin: 12rpx 0 4rpx;
}

.sub-jc {
  display: block;
  font-size: 23rpx;
  line-height: 1.75;
}

.question-line {
  display: flex;
  align-items: flex-start;
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  background: #ffffff;
  border: 2rpx solid #eceef1;
  border-radius: 16rpx;
}

.ql-k {
  width: 120rpx;
  flex: none;
  font-size: 21rpx;
  color: #e0402f;
  letter-spacing: 2rpx;
  padding-top: 4rpx;
}

.ql-v {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.7;
  color: #15171c;
  word-break: break-all;
}

.time-line {
  margin-top: 22rpx;
  text-align: center;
  font-size: 21rpx;
  color: #a2a6ad;
}

/* 保存前填写所占事项的弹层 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  background: rgba(21, 23, 28, 0.46);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.dialog {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx 30rpx 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(21, 23, 28, 0.22);
}

.dlg-t {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #15171c;
  text-align: center;
}

.dlg-d {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #71767f;
  text-align: center;
}

.dlg-input {
  width: 100%;
  box-sizing: border-box;
  margin-top: 26rpx;
  padding: 18rpx 20rpx;
  min-height: 76rpx;
  font-size: 26rpx;
  color: #15171c;
  background: #fafbfc;
  border: 2rpx solid #d8dce0;
  border-radius: 12rpx;
  -webkit-user-select: text;
  user-select: text;
}

.dlg-btns {
  display: flex;
  margin-top: 26rpx;
}

.dlg-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  border-radius: 12rpx;
  background: #e0402f;
  color: #ffffff;
}

.dlg-btn.ghost {
  margin-right: 18rpx;
  background: #f5f6f8;
  color: #71767f;
  border: 2rpx solid #d8dce0;
}
