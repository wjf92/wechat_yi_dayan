.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 10rpx 0 26rpx;
}

.hero-title {
  font-size: 62rpx;
  font-weight: 700;
  letter-spacing: 14rpx;
  margin-left: 14rpx;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #71767f;
  letter-spacing: 2rpx;
}

.illu {
  position: relative;
  padding-top: 66rpx;
  margin-bottom: 8rpx;
}

.fly-ball {
  position: absolute;
  top: 4rpx;
  left: 50%;
  margin-left: -16rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #15171c;
  box-shadow: 0 4rpx 10rpx rgba(21, 23, 28, 0.32);
  z-index: 2;
}

.fly-arrow {
  position: absolute;
  top: 38rpx;
  left: 50%;
  height: 34rpx;
  border-left: 3rpx dashed #15171c;
}

.mini-field {
  position: relative;
  width: 686rpx;
  height: 300rpx;
  background: #ffffff;
  border: 2rpx solid #dcdfe4;
  border-radius: 28rpx;
  overflow: hidden;
  margin: 0 auto;
  box-shadow: inset 0 2rpx 8rpx rgba(21, 23, 28, 0.05);
}

.illu-cap {
  display: block;
  margin-top: 14rpx;
  text-align: center;
  font-size: 21rpx;
  color: #71767f;
  letter-spacing: 1rpx;
}

.ritual-card {
  margin-top: 26rpx;
  background: #ffffff;
  border: 2rpx solid #eceef1;
  border-radius: 28rpx;
  padding: 34rpx 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(21, 23, 28, 0.04);
}

.ritual-line {
  display: block;
  font-size: 28rpx;
  color: #15171c;
  line-height: 2;
  letter-spacing: 2rpx;
}

.ritual-strong {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #e0402f;
  letter-spacing: 6rpx;
  line-height: 1.8;
}

.tips {
  margin-top: 22rpx;
  text-align: center;
  font-size: 23rpx;
  color: #71767f;
  line-height: 1.8;
}

.tips.sub {
  margin-top: 0;
  color: #a2a6ad;
}
