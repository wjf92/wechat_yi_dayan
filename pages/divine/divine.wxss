.dpage {
  padding: 22rpx 18rpx 40rpx;
}

.serif {
  font-family: "Songti SC", "STSong", serif;
}

/* ================= 头部 ================= */
.dhead {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.dh-t {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
}

.dh-m {
  font-size: 20rpx;
  color: #71767f;
  letter-spacing: 1rpx;
}

/* ================= 六爻记录带 ================= */
.record {
  display: flex;
  margin-bottom: 12rpx;
}

.rec {
  flex: 1;
  position: relative;
  margin-right: 8rpx;
  padding: 10rpx 0 8rpx;
  border: 2rpx solid #eceef1;
  border-radius: 14rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.rec:last-child {
  margin-right: 0;
}

.rec-k {
  font-size: 18rpx;
  color: #b6bac1;
  letter-spacing: 2rpx;
  line-height: 1;
}

.rec-v {
  margin-top: 8rpx;
  height: 30rpx;
  line-height: 30rpx;
  font-size: 22rpx;
  color: #c9ccd2;
}

.rec.has {
  border-color: #dcdfe4;
}

.rec.has .rec-k {
  color: #71767f;
}

.rec.has .rec-v {
  color: #15171c;
  font-weight: 700;
}

.rec.cur {
  border-color: #e0402f;
  background: #fdeeeb;
  box-shadow: 0 0 0 4rpx rgba(224, 64, 47, 0.08);
}

.rec.cur .rec-k,
.rec.cur .rec-v {
  color: #e0402f;
  font-weight: 700;
}

/* 九 / 六 标「变」 */
.rec-b {
  position: absolute;
  top: 4rpx;
  right: 6rpx;
  font-size: 14rpx;
  line-height: 1;
  color: #e0402f;
  letter-spacing: 0;
}

/* ================= 挂一 · 太极 ================= */
.taiji {
  position: relative;
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  padding: 12rpx 18rpx 12rpx 26rpx;
  border: 2rpx solid #15171c;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(21, 23, 28, 0.08);
  overflow: hidden;
}

/* 左侧竖条：强调「这一策自始至终在场」 */
.taiji::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: #15171c;
}

/* 未拈出之前只留一个淡虚位，不预先摆那颗黑球 */
.tj-ring {
  position: relative;
  width: 78rpx;
  height: 78rpx;
  flex: 0 0 78rpx;
  margin-right: 18rpx;
  border: 2rpx dashed #dcdfe4;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 太极既立，虚线圈才缓缓呼吸 */
.taiji.on .tj-ring {
  border-color: #15171c;
  animation: tjbreath 3.6s ease-in-out infinite;
}

/* 日轮升定：落定那一瞬自虚位荡开一圈暖光，随后归于常驻的墨色 */
.taiji.on .tj-ring::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 190, 96, 0.85);
  box-shadow: 0 0 22rpx 8rpx rgba(255, 178, 80, 0.42);
  animation: sunLand 700ms ease-out both;
  pointer-events: none;
}
@keyframes sunLand {
  0%   { opacity: 0.9; transform: scale(0.62); }
  100% { opacity: 0;   transform: scale(1.6); }
}

@keyframes tjbreath {
  0%, 100% {
    border-color: rgba(21, 23, 28, 0.28);
    transform: scale(1);
  }
  50% {
    border-color: rgba(21, 23, 28, 0.85);
    transform: scale(1.05);
  }
}

.tj-ball {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #15171c;
  box-shadow: 0 4rpx 12rpx rgba(21, 23, 28, 0.45);
  opacity: 0;
  transform: scale(0.94);
  /* 落定不再弹跳：与飞球几乎同尺寸同位置，稳稳涨到实位，接缝看不出来 */
  transition: opacity 0.1s ease, transform 0.2s ease-out;
}

/* 飞球落定的同一瞬显形，尺寸位置与飞球完全一致，接缝看不出来 */
.taiji.on .tj-ball {
  opacity: 1;
  transform: scale(1);
}

.tj-txt {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.tj-t {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #15171c;
  line-height: 1.2;
}

.tj-n {
  margin-top: 6rpx;
  font-size: 17rpx;
  color: #8b9099;
  letter-spacing: 0.5rpx;
  line-height: 1.3;
}

.tj-tag {
  flex: 0 0 auto;
  margin-left: 10rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: #8b9099;
  font-size: 16rpx;
  letter-spacing: 3rpx;
  line-height: 1.4;
}

.taiji.on .tj-tag {
  background: #fdeeeb;
  color: #e0402f;
}

/* ================= 席上策数：球堆外左上角 ================= */
.pile-tag {
  position: absolute;
  left: -8rpx;
  top: -10rpx;
  z-index: 9;
  display: flex;
  align-items: baseline;
  padding: 6rpx 14rpx 7rpx;
  border: 2rpx solid #15171c;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(21, 23, 28, 0.10);
  white-space: nowrap;
  pointer-events: none;
}

.pile-cap {
  margin-right: 8rpx;
  font-size: 15rpx;
  color: #8b9099;
  letter-spacing: 1rpx;
}

.pile-n {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
  color: #15171c;
}

.pile-u {
  margin-left: 4rpx;
  font-size: 16rpx;
  color: #71767f;
}

/* ================= 主体 ================= */
.dbody {
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

/* ---------- 圆席 ---------- */
.cwrap {
  position: relative;
  margin-right: 6rpx;
  flex: 0 0 auto;
}

.circl {
  position: relative;
  border: 2rpx solid #dcdfe4;
  border-radius: 50%;
  background: #ffffff;
  overflow: hidden;
  box-shadow: inset 0 2rpx 10rpx rgba(21, 23, 28, 0.05);
  box-sizing: border-box;
}

/* 球 */
.ball {
  position: absolute;
  border-radius: 50%;
  background: #ffffff;
  border: 2rpx solid #15171c;
  box-sizing: border-box;
  box-shadow: 0 2rpx 3rpx rgba(21, 23, 28, 0.16);
  transition-property: left, top, background-color, box-shadow, opacity, transform;
  transition-timing-function: cubic-bezier(0.22, 0.85, 0.3, 1);
  z-index: 2;
}

.ball.warn {
  border-color: #e0402f;
  background: #fdeeeb;
  box-shadow: 0 0 0 6rpx rgba(224, 64, 47, 0.18), 0 2rpx 6rpx rgba(224, 64, 47, 0.3);
  z-index: 3;
}

/* 球心正好压在分界线上的球：判归属只看球心，用一圈朱红虚环标出来 */
.ball.edge::after {
  content: '';
  position: absolute;
  left: -6rpx;
  top: -6rpx;
  right: -6rpx;
  bottom: -6rpx;
  border-radius: 50%;
  border: 2rpx dashed rgba(154, 42, 42, 0.55);
  pointer-events: none;
}

.ball.dark {
  background-color: #15171c;
  border-color: #15171c;
  box-shadow: 0 3rpx 8rpx rgba(21, 23, 28, 0.42);
}

/* 拈起为太极的那一策：变黑后微微抬起放大，明确告诉占者取的是哪一颗 */
.ball.dark.pick {
  transform: scale(1.26);
  z-index: 6;
  box-shadow: 0 6rpx 18rpx rgba(21, 23, 28, 0.55), 0 0 0 5rpx rgba(21, 23, 28, 0.14);
}

/* 归奇已离席：原位留一个虚线小圈，标明这几策是从哪儿扐出去的 */
.ball.ghost {
  background-color: transparent;
  border: 2rpx dashed rgba(21, 23, 28, 0.42);
  box-shadow: none;
  transform: scale(0.62);
  transition-duration: 320ms !important;
}

/* 彻底离席（下一变重铺时才会用到） */
.ball.gone {
  opacity: 0;
  transform: scale(0.45);
  transition-duration: 300ms !important;
}

/* 重新出场的球（洗牌时补回来的） */
.ball.pop {
  animation: ballpop 0.42s ease both;
}

@keyframes ballpop {
  from {
    opacity: 0;
    transform: scale(0.55);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* 画布：你画的线 + 手绘圈 */
.ink {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 5;
}

/* 左 / 右角标：避开左上角那枚「在席 N 策」标签 */
.dtag {
  position: absolute;
  top: 58rpx;
  z-index: 7;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 2rpx solid #dcdfe4;
  font-size: 16rpx;
  color: #71767f;
  letter-spacing: 1rpx;
  opacity: 0;
  transition: opacity 0.2s;
}

.dtag.on {
  opacity: 1;
}

.dtag-l {
  left: 12rpx;
}

.dtag-r {
  right: 12rpx;
}

.dtag-b {
  color: #15171c;
  font-weight: 700;
}

/* ---------- 成爻 ---------- */
.yao-calc {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 6;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  animation: fadeup 0.42s ease both;
}

@keyframes fadeup {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.yc-cap {
  font-size: 18rpx;
  color: #71767f;
  letter-spacing: 6rpx;
}

.yc-eq {
  font-size: 22rpx;
  color: #71767f;
  margin-top: 6rpx;
}

.yc-num {
  font-size: 132rpx;
  font-weight: 700;
  line-height: 1.1;
  margin-top: 4rpx;
}

.yao-line {
  width: 96rpx;
  height: 14rpx;
  margin-top: 10rpx;
}

.yao-line.yang {
  background: #15171c;
  border-radius: 2rpx;
}

.yao-line.yin {
  display: flex;
  justify-content: space-between;
}

.yao-line.yin::before,
.yao-line.yin::after {
  content: "";
  width: 38rpx;
  height: 14rpx;
  background: #15171c;
  border-radius: 2rpx;
}

/* ---------- 三变柱：黑球自上而下计归奇，三段留空当 ---------- */
.pillars {
  width: 112rpx;
  flex: 0 0 112rpx;
  display: flex;
  align-self: center;
  padding-top: 0;
}

.pil {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 4rpx;
  min-width: 0;
}

.pil:last-child {
  margin-right: 0;
}

.pil-lab {
  font-size: 15rpx;
  color: #b6bac1;
  white-space: nowrap;
  letter-spacing: 0;
}

.pil-num {
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
  margin-top: 6rpx;
}

.pil-dots {
  width: 100%;
  height: 200rpx;
  margin-top: 8rpx;
  padding: 10rpx 0;
  border: 2rpx solid #eceef1;
  border-radius: 12rpx;
  background: #fafbfc;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  overflow: hidden;
}

/* 归奇落定：实心黑球（自上而下：挂 1 ｜ 右余 ｜ 左余） */
.bdot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  box-sizing: border-box;
  background: #15171c;
  border: none;
  flex: 0 0 12rpx;
}

/* 尚未归奇：极淡的空位 */
.bdot.g {
  background: #e3e6ea;
}

/* 段与段之间留空当：挂 1 ｜ 右余 ｜ 左余 */
.bdot.gap {
  margin-top: 12rpx;
}


/* ================= 下方步骤轨 ================= */
.steps {
  display: flex;
  align-items: center;
  margin: 0 4rpx;
}

.stp {
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  border-radius: 50%;
  border: 2rpx solid #dcdfe4;
  background: #ffffff;
  color: #c3c7cd;
  font-size: 18rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.stp.done {
  border-color: #15171c;
  color: #15171c;
}

.stp.cur {
  background: #15171c;
  border-color: #15171c;
  color: #ffffff;
  transform: scale(1.08);
  box-shadow: 0 6rpx 16rpx rgba(21, 23, 28, 0.3);
}

.stp-line {
  flex: 1;
  height: 2rpx;
  margin: 0 4rpx;
  background: #eceef1;
}

.stp-line.done {
  background: #15171c;
}

.stpname {
  margin-top: 20rpx;
  margin-bottom: 12rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #15171c;
  letter-spacing: 3rpx;
}

/* ================= 底部 ================= */
.dbot {
  margin-top: 18rpx;
}

.dhint {
  display: block;
  margin-top: 14rpx;
  text-align: center;
  font-size: 20rpx;
  color: #71767f;
  line-height: 1.7;
  white-space: pre-line;
}

/* 计数 chip */
.chips {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.chip {
  padding: 4rpx 18rpx;
  margin: 0 5rpx;
  border: 2rpx solid #dcdfe4;
  border-radius: 999rpx;
  background: #ffffff;
  font-size: 20rpx;
  color: #15171c;
}

.chip.dark-chip {
  background: #15171c;
  border-color: #15171c;
  color: #ffffff;
}

.chip.sum {
  background: #e0402f;
  border-color: #e0402f;
  color: #ffffff;
  font-weight: 600;
}

/* 算式：不再做黑底卡片，与 .dhint 同一套说明文字排版 */
.formula {
  margin-top: 10rpx;
  padding: 0;
  background: transparent;
  border-radius: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.f-cap {
  font-size: 18rpx;
  color: #9aa0aa;
  letter-spacing: 4rpx;
  line-height: 1.7;
}

.f-eq {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #71767f;
  white-space: nowrap;
  letter-spacing: 0.5rpx;
  line-height: 1.7;
}

.f-note {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: #9aa0aa;
  letter-spacing: 0.5rpx;
  line-height: 1.7;
}

/* 按钮：紧跟步骤轨，.dbot 的 18rpx 上边距即与步骤条的间距 */
.btn {
  margin-top: 0;
  width: 100%;
  padding: 22rpx 0;
  border-radius: 20rpx;
  background: #e0402f;
  color: #ffffff;
  font-size: 28rpx;
  letter-spacing: 8rpx;
  font-weight: 600;
  height: auto;
  line-height: 1.2;
  box-shadow: 0 8rpx 24rpx rgba(224, 64, 47, 0.26);
}

.btn::after {
  border: none;
}

.btn.wait {
  background: #f0f1f3;
  color: #a8adb5;
  box-shadow: none;
}

.lock {
  margin-top: 16rpx;
  padding: 12rpx;
  border: 2rpx dashed #e0402f;
  border-radius: 14rpx;
  background: #fdeeeb;
  font-size: 19rpx;
  color: #e0402f;
  text-align: center;
  line-height: 1.6;
}

.relink {
  margin-top: 16rpx;
  text-align: center;
  font-size: 20rpx;
  color: #71767f;
  text-decoration: underline;
}

/* ================= 飞球 ================= */
.flyball {
  position: fixed;
  z-index: 99;
  border-radius: 50%;
  background: #15171c;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  box-shadow: 0 3rpx 10rpx rgba(21, 23, 28, 0.45);
  transition-property: transform, background-color, border-color, box-shadow;
  transition-timing-function: cubic-bezier(0.45, 0.05, 0.25, 1);
  pointer-events: none;
}

/* 落定：收成柱内那颗实心小黑球 */
.flyball.land {
  background-color: #15171c;
  border: none;
  box-shadow: none;
}

/* ================= 挂一 · 如日之初升 =================
   位移由 JS 分四拍喂给 transition（慢起缓停），光感则全交给这里的
   keyframes 独立承担：即使某次 setData 在真机上被合并、位移没播出来，
   「由暗转明 → 日晕铺开 → 光华收回」的完整过程依然看得见，不会像闪现。 */
.flyball.sun {
  transition-property: transform;
  transition-timing-function: cubic-bezier(0.34, 0.02, 0.22, 1);
  animation: sunBody 1600ms ease-in-out both;
}

/* 本体：墨色日轮由内敛到镀上暖金边，升定后光华收回 */
@keyframes sunBody {
  0% {
    border-color: rgba(255, 198, 104, 0);
    box-shadow: 0 3rpx 10rpx rgba(21, 23, 28, 0.45);
  }
  16% {
    border-color: rgba(255, 198, 104, 0.92);
    box-shadow: 0 0 16rpx 4rpx rgba(255, 182, 84, 0.62),
                0 0 34rpx 12rpx rgba(232, 126, 46, 0.30);
  }
  62% {
    border-color: rgba(255, 210, 130, 0.78);
    box-shadow: 0 0 22rpx 7rpx rgba(255, 182, 84, 0.55),
                0 0 48rpx 18rpx rgba(232, 126, 46, 0.24);
  }
  100% {
    border-color: rgba(255, 198, 104, 0);
    box-shadow: 0 3rpx 10rpx rgba(21, 23, 28, 0.45);
  }
}

/* 日晕：朱金暖光自球心向外铺开，再随升空缓缓淡去 */
.flyball.sun::before {
  content: "";
  position: absolute;
  left: -80%;
  top: -80%;
  width: 260%;
  height: 260%;
  border-radius: 50%;
  background: radial-gradient(circle,
              rgba(255, 214, 138, 0.62) 0%,
              rgba(255, 176, 76, 0.34) 28%,
              rgba(224, 64, 47, 0.16) 48%,
              rgba(224, 64, 47, 0) 70%);
  opacity: 0;
  transform: scale(0.5);
  animation: sunGlow 1600ms ease-out both;
  pointer-events: none;
}
@keyframes sunGlow {
  0%   { opacity: 0;    transform: scale(0.5); }
  20%  { opacity: 0.95; transform: scale(1.0); }
  64%  { opacity: 0.78; transform: scale(1.32); }
  100% { opacity: 0;    transform: scale(1.62); }
}

/* 日冕环：一圈细金环自轮缘荡开，像旭日的光波 */
.flyball.sun::after {
  content: "";
  position: absolute;
  left: -4rpx;
  right: -4rpx;
  top: -4rpx;
  bottom: -4rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 196, 100, 0.9);
  opacity: 0;
  animation: sunRim 1200ms ease-out both;
  pointer-events: none;
}
@keyframes sunRim {
  0%   { opacity: 0;    transform: scale(0.9); }
  18%  { opacity: 0.85; transform: scale(1.0); }
  55%  { opacity: 0.35; transform: scale(1.9); }
  78%  { opacity: 0.6;  transform: scale(1.0); }
  100% { opacity: 0;    transform: scale(2.3); }
}
